APP_NAME="ECL Task Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
API_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecl_task_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=

CORS_ALLOWED_ORIGINS=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Firebase Admin SDK service-account JSON file (keep this file outside source control).
# Example: C:/path/to/firebase-service-account.json
FIREBASE_CREDENTIALS=
