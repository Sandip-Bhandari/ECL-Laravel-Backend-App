APP_NAME="ECL Task Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecl_task_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=

# Current Android UI has employee email-only quick login.
# Set false for production and use the password field/API below.
ALLOW_EMAIL_ONLY_EMPLOYEE_LOGIN=true

# Used by Android for public attachment URLs when APP_URL is not enough.
MEDIA_URL=${APP_URL}/storage
